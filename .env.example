# Plaid credentials (dashboard.plaid.com -> Developers -> Keys)
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox
# Required for OAuth banks (Chase, BofA, Wells, ...). Must also be added in the
# Plaid dashboard under API -> Allowed redirect URIs. Must be https in production.
# PLAID_REDIRECT_URI=https://your-app.onrender.com/

# Password that protects the whole site (HTTP Basic Auth, any username).
APP_PASSWORD=change-me

# Encrypts Plaid access tokens at rest. Any long random string; don't change it once set.
# ENCRYPTION_KEY=

# How often to sync in the background (hours). 0 disables.
# SYNC_INTERVAL_HOURS=6

# CockroachDB / Postgres connection string. If unset, data is stored in ./data/store.json (local dev only).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full
# Force SSL without certificate verification (only for hosts whose certs can't be verified).
# PGSSL=false

PORT=3000
