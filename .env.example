# Plaid credentials (dashboard.plaid.com -> Developers -> Keys)
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production
PLAID_ENV=sandbox
# Required for OAuth banks (Chase, BofA, Wells, ...). Must also be added in the
# Plaid dashboard under API -> Allowed redirect URIs. Must be https in production.
# PLAID_REDIRECT_URI=https://your-app.onrender.com/

# Password that protects the whole site (HTTP Basic Auth, any username).
APP_PASSWORD=change-me

# Postgres connection string. If unset, data is stored in ./data/store.json (local dev only).
# DATABASE_URL=postgres://user:pass@localhost:5432/mymint
# Set to true when connecting to a Postgres that requires SSL (e.g. Render external URL).
# PGSSL=false

PORT=3000
